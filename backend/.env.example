# ─────────────────────────────────────────────────────────
# VED DAKSHA FOUNDATION — Backend Environment Variables
# Copy this file, rename to .env, and fill in your values
# ─────────────────────────────────────────────────────────

# MongoDB Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/veddaksha?retryWrites=true&w=majority

# JWT Secret (use a long random string — min 32 chars)
JWT_SECRET=change_this_to_a_very_long_random_secret_string_123456

# Admin credentials (first-time setup — change immediately after first login)
ADMIN_EMAIL=admin@veddakshafoundation.org
ADMIN_PASSWORD=VedDaksha@Admin2024

# Server Configuration
PORT=5000

# Email (for donation confirmations — use Gmail App Password)
EMAIL_USER=veddakshafoundation22@gmail.com
EMAIL_PASS=your_gmail_app_password_here

# Razorpay (optional — for online payments)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Frontend URL (for CORS)
FRONTEND_URL=https://veddakshafoundation.org

# Donation Details (Displayed on Frontend)
DONATION_UPI_ID=veddakshafoundation22@gmail.com
DONATION_PHONE=8700785399
DONATION_EMAIL=veddakshafoundation22@gmail.com
